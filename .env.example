# AI Provider — configure one (or both) of the following:

# Groq API key (recommended — fast inference, free tier available)
# Get yours at https://console.groq.com/keys
# When set, Groq is used with llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API key (used if GROQ_API_KEY is not set)
# Get yours at https://platform.openai.com/api-keys
# When set, OpenAI is used with gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# Provider selection: Groq takes priority over OpenAI.
# If neither key is set, a regex-based fallback analyzer is used.
